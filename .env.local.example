# Copy to .env.local and fill in.
#
# Local dev (after `pnpm exec supabase start`): the CLI prints these values
# (API URL + anon key) in its output — paste them in as-is.
#
# Hosted project: found under Project Settings > API in the Supabase dashboard.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — server-only, never expose to the browser (no NEXT_PUBLIC_
# prefix). Needed for privileged writes that bypass RLS, e.g. guest checkout
# creating a customer/booking row without a logged-in staff session.
SUPABASE_SERVICE_ROLE_KEY=

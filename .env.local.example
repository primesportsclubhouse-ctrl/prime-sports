# Copy to .env.local and fill in.
#
# Local dev (after `pnpm exec supabase start`): the CLI prints these values
# (API URL + anon key) in its output — paste them in as-is.
#
# Hosted project: found under Project Settings > API in the Supabase dashboard.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — server-only, never expose to the browser (no NEXT_PUBLIC_
# prefix). Needed for privileged writes that bypass RLS, e.g. guest checkout
# creating a customer/booking row without a logged-in staff session.
SUPABASE_SERVICE_ROLE_KEY=

# Google Cloud Vision API key — server-only. Powers real receipt OCR at
# /api/ocr/receipt (extracts a PRS-XXXXXX reference from the uploaded receipt
# image via TEXT_DETECTION). To get one: Google Cloud Console > select/create
# a project > APIs & Services > Library > enable "Cloud Vision API" > APIs &
# Services > Credentials > Create Credentials > API key (restrict it to the
# Cloud Vision API). Leave empty to run without OCR — /api/ocr/receipt
# degrades honestly to a 501 "not configured" response and checkout falls
# back to today's manual reference entry; nothing breaks if this is unset.
GOOGLE_CLOUD_VISION_API_KEY=

# Resend API key — server-only. Powers the booking-confirmation email sent
# from lib/email.ts (via lib/supabase/notifications.ts) once a staff member
# approves a payment submission. To get one: sign up at https://resend.com >
# Dashboard > API Keys > Create API Key. You'll also want to verify a
# sending domain under Dashboard > Domains before mail can reach recipients
# outside your own Resend account (Resend's shared sandbox sender only
# delivers to the account owner's own address). Leave empty to run without
# email confirmations — sendBookingConfirmationEmail() degrades honestly to
# a logged "skipped" notification_log row; nothing breaks if this is unset.
RESEND_API_KEY=

# Optional — overrides the "from" address used for booking-confirmation
# email. Must be on a domain verified in the Resend dashboard. Defaults to
# Resend's sandbox sender (onboarding@resend.dev) if unset.
RESEND_FROM_EMAIL=

# Semaphore API key — server-only. Powers the booking-confirmation SMS sent
# from lib/sms.ts (via lib/supabase/notifications.ts) once a staff member
# approves a payment submission. Semaphore is a Philippines-focused SMS
# gateway, matching this business's location. To get one: sign up at
# https://semaphore.co > Account > API Keys (a small free credit balance is
# usually included; sends beyond that consume paid credits). Leave empty to
# run without SMS confirmations — sendBookingConfirmationSms() degrades
# honestly to a logged "skipped" notification_log row; nothing breaks if
# this is unset.
SEMAPHORE_API_KEY=

# Optional — Semaphore Sender Name shown to recipients (must be one of your
# account's approved Sender Names). Uses Semaphore's shared default sender
# if unset.
SEMAPHORE_SENDER_NAME=
